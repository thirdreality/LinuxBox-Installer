#!/bin/bash

set -e

case "$1" in
    install|upgrade)
        if command -v systemctl >/dev/null 2>&1; then
            if [[ "$(systemctl is-active home-assistant.service 2>/dev/null || true)" == "active" ]]; then
                echo "Stopping home-assistant.service"
                systemctl stop home-assistant.service || true
            fi

            if [[ "$(systemctl is-active matter-server.service 2>/dev/null || true)" == "active" ]]; then
                echo "Stopping matter-server.service"
                systemctl stop matter-server.service || true
            fi
        fi
        
        # 如果是升级，移除 /usr/local/bin 下的符号链接
        if [ "$1" = "upgrade" ]; then
            echo "Removing symlinks from /usr/local/bin"
            for link in python python3 python3-config pip pip3; do
                link_path="/usr/local/bin/$link"
                if [ -L "$link_path" ]; then
                    echo "Removing symlink: $link_path"
                    rm -f "$link_path" || true
                fi
            done
        fi
        ;;
esac
