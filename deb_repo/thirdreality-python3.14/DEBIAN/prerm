#!/bin/bash
set -e

case "$1" in
    remove|purge)
        # If the home-assistant service is running or exists, stop it
        if command -v systemctl >/dev/null 2>&1; then
            if [[ "$(systemctl is-active home-assistant.service 2>/dev/null || true)" == "active" ]]; then
                echo "Stopping home-assistant.service"
                systemctl stop home-assistant.service || true
            fi

            if [[ "$(systemctl is-active matter-server.service 2>/dev/null || true)" == "active" ]]; then
                echo "Stopping matter-server.service"
                systemctl stop matter-server.service || true
            fi
        fi

        # Remove symlinks only if they point to this package's install path to avoid removing system Python
        for link in /usr/local/bin/python3 /usr/local/bin/python /usr/local/bin/pip3 /usr/local/bin/pip /usr/local/bin/python3-config; do
            if [ -L "$link" ]; then
                target=$(readlink -f "$link" || true)
                case "$target" in
                    /usr/local/python3/*)
                        rm -f "$link"
                        ;;
                esac
            fi
        done
        ;;
esac

exit 0
