#!/bin/sh
set -e

case "$1" in
    purge)
        # Remove log directory under data, but keep /opt/zigbee2mqtt/data/ itself
        rm -rf /opt/zigbee2mqtt/data/log || true
        
        # Remove zigbee2mqtt directory contents except data folder
        find /opt/zigbee2mqtt/ -mindepth 1 -maxdepth 1 ! -name 'data' -exec rm -rf {} \; 2>/dev/null || true
        
        # Remove zigbee-herdsman directory
        rm -rf /opt/zigbee-herdsman/ || true
    ;;
    remove|abort-install|abort-upgrade|disappear)
    ;;

    upgrade|failed-upgrade)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

