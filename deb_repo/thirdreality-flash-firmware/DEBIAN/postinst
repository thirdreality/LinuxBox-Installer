#!/bin/bash
set -e

# Check whether this is install or upgrade
if [ "$1" = "configure" ]; then
    # Ensure tools are executable
    if [ -f "/usr/lib/thirdreality/images/upgrade_firmware.sh" ]; then
        chmod +x /usr/lib/thirdreality/images/upgrade_firmware.sh
    fi
    if [ -f "/usr/lib/thirdreality/images/check_thread_firmware.py" ]; then
        chmod +x /usr/lib/thirdreality/images/check_thread_firmware.py
    fi
    if [ -f "/usr/lib/thirdreality/images/check_zigbee_firmware.py" ]; then
        chmod +x /usr/lib/thirdreality/images/check_zigbee_firmware.py
    fi
elif [ "$1" = "fix-dependency" ]; then
    # Ensure tools are executable
    if [ -f "/usr/lib/thirdreality/images/upgrade_firmware.sh" ]; then
        chmod +x /usr/lib/thirdreality/images/upgrade_firmware.sh
    fi
    if [ -f "/usr/lib/thirdreality/images/check_thread_firmware.py" ]; then
        chmod +x /usr/lib/thirdreality/images/check_thread_firmware.py
    fi
    if [ -f "/usr/lib/thirdreality/images/check_zigbee_firmware.py" ]; then
        chmod +x /usr/lib/thirdreality/images/check_zigbee_firmware.py
    fi

    echo "Start to flash board firmware (configure) ..."
    if [ -f "/usr/lib/thirdreality/images/upgrade_firmware.sh" ]; then
        /usr/lib/thirdreality/images/upgrade_firmware.sh
    else
        echo "upgrade_firmware.sh not found, skip flashing" >&2
        exit 1
    fi
    echo "Flash board firmware finished."
fi

exit 0

