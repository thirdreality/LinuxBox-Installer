# Default settings for otbr-web. This file is sourced by systemd.
#
# Options to pass to otbr-web (see: otbr-web -h):
#   -I interfaceName    Thread interface (must match otbr-agent, wpan0)
#   -p port             Web GUI listen port (avoid the very common port 80)
#   -a listenAddress    Web GUI listen address (0.0.0.0 = reachable from LAN)
#   -A restListenAddress / -P restListenPort   REST backend (otbr-agent REST)
OTBR_WEB_OPTS="-I wpan0 -p 8080 -a 0.0.0.0"
