[Unit]
Description=HubV3 otbr agent start service
After=network-online.target otbr-agent.service
Wants=network-online.target
# Master switch: enabling/starting this service pulls in otbr-agent (which in turn
# brings up otbr-web). Devices with no Thread chip, or that do not want Thread,
# only need to disable this service to turn the whole stack off.
Wants=otbr-agent.service

[Service]
Type=oneshot
Environment=PATH=/srv/homeassistant/bin:/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/lib/thirdreality/hubv3-otbr-agent.sh
RemainAfterExit=true
TimeoutStartSec=180
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
