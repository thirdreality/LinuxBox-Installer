# otbr-agent startup parameters
# -I: Thread virtual interface (always wpan0)
# -B: backbone interface (wireless NIC)
# -d: log level (5=NOTICE)
# --rest-listen-address: REST API listen address (0.0.0.0 allows external access)
# --rest-listen-port:    REST API port (default 8081)
OTBR_AGENT_OPTS="-I wpan0 -B wlan0 -d 5 --rest-listen-address 0.0.0.0 --rest-listen-port 8081 spinel+hdlc+uart:///dev/ttyAML6?uart-baudrate=115200 trel://wlan0"
OTBR_NO_AUTO_ATTACH=0

# Firewall / NAT64 toggles (read by /usr/lib/thirdreality/otbr-firewall.sh) and
# interface names. THREAD_IF must match -I in OTBR_AGENT_OPTS; BACKBONE_IF must match -B.
OTBR_THREAD_IF=wpan0
OTBR_BACKBONE_IF=wlan0
OTBR_FIREWALL=1
OTBR_NAT64=1
