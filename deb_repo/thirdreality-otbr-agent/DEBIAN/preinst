#!/bin/bash
# Before install/upgrade: stop the old services

# Stop the hubv3 master switch first (PartOf stops otbr-agent, which triggers the
# firewall teardown, and BindsTo stops otbr-web), then each one as a fallback
for svc in hubv3-otbr-agent otbr-web otbr-agent; do
    if systemctl is-active --quiet "${svc}" 2>/dev/null; then
        echo "Stopping ${svc}..."
        systemctl stop    "${svc}" || true
        systemctl disable "${svc}" || true
    fi
done

# On upgrade, clean up leftovers from the old mDNSResponder setup (old versions only)
rm -f /usr/sbin/mdnsd /usr/bin/dns-sd
rm -f /usr/lib/libdns_sd.so /usr/lib/libdns_sd.so.1
rm -f /usr/lib/libnss_mdns-0.2.so /usr/lib/libnss_mdns.so.2
rm -f /lib/libnss_mdns-0.2.so /lib/libnss_mdns.so.2
rm -f /etc/init.d/mdns /etc/init.d/otbr-nat44
rm -f /etc/rc?.d/*mdns /etc/rc?.d/*nat44 2>/dev/null || true

systemctl daemon-reload
