#!/bin/bash
set -e

INFRA_IF="wlan0"

accept_ra_enable() {
    echo 2 > /proc/sys/net/ipv6/conf/${INFRA_IF}/accept_ra || true
    echo 64 > /proc/sys/net/ipv6/conf/${INFRA_IF}/accept_ra_rt_info_max_plen || true
}

ipforward_enable() {
    echo 1 > /proc/sys/net/ipv6/conf/all/forwarding || true
    echo 1 > /proc/sys/net/ipv4/ip_forward || true
}

rt_tables_install() {
    # Remove duplicates, then append
    sed -i.bak '/88[[:space:]]\+openthread/d' /etc/iproute2/rt_tables
    echo "88 openthread" >> /etc/iproute2/rt_tables

    # optmem_max (append only once)
    if ! grep -q "optmem_max" /etc/sysctl.conf 2>/dev/null; then
        echo "" >> /etc/sysctl.conf
        echo "# OpenThread configuration" >> /etc/sysctl.conf
        echo "net.core.optmem_max=65536" >> /etc/sysctl.conf
    fi
    sysctl -p /etc/sysctl.conf || true
}

add_open_thread_entry_to_config() {
    echo "Checking if Thread Border Router API is available..."
    local max_attempts=5
    local attempt=1

    while [ $attempt -le $max_attempts ]; do
        response=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8081/node 2>/dev/null || echo "0")
        if [ "$response" = "200" ] || [ "$response" = "204" ]; then
            echo "Thread API available (HTTP ${response})"
            # Not fatal (installing a package should not abort over this), but it must
            # be surfaced: a failure here means there is no active dataset, so Thread
            # stays disabled. This used to be swallowed by `|| true`.
            if ! /usr/lib/thirdreality/otbr_database; then
                echo "[WARN] otbr_database failed; Thread may stay disabled without an active dataset."
            fi
            return 0
        fi
        echo "Thread API not ready (HTTP ${response}), waiting... (${attempt}/${max_attempts})"
        sleep 1
        attempt=$((attempt + 1))
    done
    echo "Thread API unavailable after ${max_attempts} attempts, skipping."
    return 0
}

if [ "$1" = "configure" ]; then

    mkdir -p /var/lib/thread

    # --- sysctl & routing table ---
    accept_ra_enable
    ipforward_enable
    rt_tables_install

    # --- Kernel modules ---
    modprobe ip6table_filter || true
    modprobe ip6_tables      || true
    modprobe xt_set          || true

    # --- Script permissions ---
    chmod +x /usr/lib/thirdreality/hubv3-otbr-agent.sh || true
    chmod +x /usr/lib/thirdreality/otbr_database       || true
    chmod +x /usr/lib/thirdreality/otbr-firewall.sh    || true

    # --- systemd ---
    # The firewall is built and torn down in pairs by otbr-agent.service's
    # ExecStartPre/ExecStopPost, so it is no longer started separately here.
    # Only enable the hubv3-otbr-agent master switch: it Wants=otbr-agent (which in
    # turn Wants=otbr-web), so otbr-agent/otbr-web are not enabled on their own and
    # are pulled in by the master. Devices with no Thread chip, or that do not want
    # Thread, only need to disable hubv3-otbr-agent to turn the whole stack off.
    systemctl daemon-reload
    # Clear any standalone autostart left over from older versions (the old postinst
    # used to enable otbr-agent/otbr-web); under the new model they are only pulled
    # in by the hubv3 master and should not be enabled independently.
    systemctl disable otbr-agent.service otbr-web.service 2>/dev/null || true
    systemctl enable hubv3-otbr-agent.service || true

    # Skip auto-start when a backup restore flow is in progress
    SKIP_AUTO_CONFIG=false
    if [ -d "/mnt/R3Backup" ] && [ ! -f "/mnt/R3Backup/.enable-backup" ] && [ -f "/mnt/R3Backup/.enable-restore" ]; then
        BACKUP_FILES=$(ls /mnt/R3Backup/setting_*.tar.gz 2>/dev/null | wc -l)
        if [ "$BACKUP_FILES" -gt 0 ]; then
            echo "[INFO] Found backup files, skipping auto-configuration."
            SKIP_AUTO_CONFIG=true
        fi
    fi

    if [ "$SKIP_AUTO_CONFIG" = "false" ]; then
        # Starting the master switch pulls in otbr-agent (whose ExecStartPre builds
        # the firewall) and brings up otbr-web with it
        systemctl start hubv3-otbr-agent.service || true

        if [ -e "/usr/local/bin/supervisor" ]; then
            /usr/local/bin/supervisor thread enabled || true
        fi

        # Write the HA config
        if systemctl is-active --quiet home-assistant.service; then
            echo "Stopping home-assistant.service..."
            systemctl stop home-assistant.service
            sync
            add_open_thread_entry_to_config
            sync
            echo "Restoring home-assistant.service..."
            systemctl start home-assistant.service
        else
            add_open_thread_entry_to_config
            sync
        fi
    fi

    echo "Install OTBR-Agent success."

elif [ "$1" = "fix-dependency" ]; then
    echo "fix-dependency"
fi

exit 0
