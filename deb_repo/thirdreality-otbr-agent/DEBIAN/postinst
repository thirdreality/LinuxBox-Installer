#!/bin/bash
set -e

INFRA_IF="wlan0"

accept_ra_enable() {
    echo 2 > /proc/sys/net/ipv6/conf/${INFRA_IF}/accept_ra || true
    echo 64 > /proc/sys/net/ipv6/conf/${INFRA_IF}/accept_ra_rt_info_max_plen || true
}

ipforward_enable() {
    echo 1 > /proc/sys/net/ipv6/conf/all/forwarding || true
    echo 1 > /proc/sys/net/ipv4/ip_forward || true
}

rt_tables_install() {
    # 去重后添加
    sed -i.bak '/88[[:space:]]\+openthread/d' /etc/iproute2/rt_tables
    echo "88 openthread" >> /etc/iproute2/rt_tables

    # optmem_max（只添加一次）
    if ! grep -q "optmem_max" /etc/sysctl.conf 2>/dev/null; then
        echo "" >> /etc/sysctl.conf
        echo "# OpenThread configuration" >> /etc/sysctl.conf
        echo "net.core.optmem_max=65536" >> /etc/sysctl.conf
    fi
    sysctl -p /etc/sysctl.conf || true
}

add_open_thread_entry_to_config() {
    echo "Checking if Thread Border Router API is available..."
    local max_attempts=5
    local attempt=1

    while [ $attempt -le $max_attempts ]; do
        response=$(curl -s -o /dev/null -w "%{http_code}" http://localhost:8081/node 2>/dev/null || echo "0")
        if [ "$response" = "200" ] || [ "$response" = "204" ]; then
            echo "Thread API available (HTTP ${response})"
            /usr/lib/thirdreality/otbr_database || true
            return 0
        fi
        echo "Thread API not ready (HTTP ${response}), waiting... (${attempt}/${max_attempts})"
        sleep 1
        attempt=$((attempt + 1))
    done
    echo "Thread API unavailable after ${max_attempts} attempts, skipping."
    return 0
}

if [ "$1" = "configure" ]; then

    mkdir -p /var/lib/thread

    # --- sysctl & 路由表 ---
    accept_ra_enable
    ipforward_enable
    rt_tables_install

    # --- 内核模块 ---
    modprobe ip6table_filter || true
    modprobe ip6_tables      || true
    modprobe xt_set          || true

    # --- 脚本权限 ---
    chmod +x /usr/lib/thirdreality/hubv3-otbr-agent.sh || true
    chmod +x /usr/lib/thirdreality/otbr_database       || true
    chmod +x /etc/init.d/otbr-firewall

    # --- 注册 otbr-firewall（兜底，ExecStartPre 是主路径）---
    update-rc.d otbr-firewall defaults || true

    # --- 启动 firewall，创建 ipset ---
    /etc/init.d/otbr-firewall start || true

    # --- systemd ---
    systemctl daemon-reload
    systemctl enable otbr-agent.service  || true
    systemctl enable otbr-web.service    || true

    # 检查是否有备份恢复流程，有则跳过自动启动
    SKIP_AUTO_CONFIG=false
    if [ -d "/mnt/R3Backup" ] && [ ! -f "/mnt/R3Backup/.enable-backup" ] && [ -f "/mnt/R3Backup/.enable-restore" ]; then
        BACKUP_FILES=$(ls /mnt/R3Backup/setting_*.tar.gz 2>/dev/null | wc -l)
        if [ "$BACKUP_FILES" -gt 0 ]; then
            echo "[INFO] Found backup files, skipping auto-configuration."
            SKIP_AUTO_CONFIG=true
        fi
    fi

    if [ "$SKIP_AUTO_CONFIG" = "false" ]; then
        systemctl start otbr-agent.service || true
        systemctl start otbr-web.service   || true

        if [ -e "/usr/local/bin/supervisor" ]; then
            /usr/local/bin/supervisor thread enabled || true
        fi

        # 写入 HA 配置
        if systemctl is-active --quiet home-assistant.service; then
            echo "Stopping home-assistant.service..."
            systemctl stop home-assistant.service
            sync
            add_open_thread_entry_to_config
            sync
            echo "Restoring home-assistant.service..."
            systemctl start home-assistant.service
        else
            add_open_thread_entry_to_config
            sync
        fi
    fi

    echo "Install OTBR-Agent success."

elif [ "$1" = "fix-dependency" ]; then
    echo "fix-dependency"
fi

exit 0
