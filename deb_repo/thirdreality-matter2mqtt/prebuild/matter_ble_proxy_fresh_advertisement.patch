+# matter.js keeps discovered devices for 15 minutes and connects to one from an earlier scan at once: a rotated
+# address that no longer exists, or a device whose BlueZ object is gone. Only connect to what advertised lately.
+_FRESH_SECONDS = 3.0
+# Commands are handled one at a time, so this wait holds up every other command; commissionable devices
+# advertise at least every ~1.2 s.
+_FRESH_WAIT_SECONDS = 3.0
