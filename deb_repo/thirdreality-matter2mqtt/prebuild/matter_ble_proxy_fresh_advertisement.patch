+        """Whether the scanner is running."""
+        return self._scanner is not None
+
+    def seen_within(self, address: str, seconds: float) -> bool:
+        """Whether `address` advertised in the last `seconds`."""
+        seen = self._last_seen.get(address)
+        return seen is not None and time.monotonic() - seen <= seconds
+
+    async def wait_for_advertisement(self, address: str, timeout: float) -> bool:
+        """Wait until `address` advertises; False on timeout."""
+        event = self._advertised.setdefault(address, asyncio.Event())
+        try:
+            async with asyncio.timeout(timeout):
+                await event.wait()
+        except TimeoutError:
+            return False
+        finally:
+            if self._advertised.get(address) is event:
+                del self._advertised[address]
+        return True
