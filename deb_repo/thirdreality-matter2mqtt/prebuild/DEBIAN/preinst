#!/bin/bash
# thirdreality-matter2mqtt preinst
#
# matter2mqtt coexists with the Home Assistant + matter-server stack ON DISK: installing
# this package installs files only and never touches the native stack. It deliberately does
# NOT stop, disable or delete home-assistant.service / matter-server.service, and it does
# NOT remove /srv/homeassistant or /srv/matter_server -- those are hacore's program trees,
# and deleting them left dpkg believing thirdreality-hacore was still installed while HA was
# in fact gutted (a same-version hacore deb is then skipped by the USB installer, so there
# was no way back).
#
# The stacks do contend AT RUNTIME, and arbitration happens in postinst, per unit and per
# resource: matter2mqtt.service is enabled+started only when matter-server.service is absent
# or not enabled (both bind :5580), and matter-ble-proxy.service only when
# home-assistant.service is absent or not enabled (both drive the BLE adapter). Whatever is
# left out stays exactly as it was -- not started, not enabled, not disabled.
set -e

# Stop OUR OWN services before the unpack replaces /opt/matter2mqtt (node_modules and the
# BLE venv, ~25k files): a running node/python whose files change underneath it behaves
# unpredictably. On a normal upgrade dpkg has already run the OLD package's prerm for this
# (order: old-prerm upgrade -> new-preinst upgrade -> unpack -> new-postinst configure), so
# this is a belt-and-braces repeat that also covers the cases where that did not happen --
# a half-installed/half-configured leftover from an interrupted run, or a forced dpkg -i.
# Idempotent and harmless on a fresh install, where neither unit exists yet.
#
# Deliberately `stop` only, never `disable`: postinst re-enables (and starts) a unit only
# when its conflicting peer is absent, so disabling here would silently drop an enable state
# an operator set on purpose. Restarting after the upgrade is postinst's decision.
if [ -x /usr/bin/systemctl ]; then
    /usr/bin/systemctl stop matter-ble-proxy.service 2>/dev/null || true
    /usr/bin/systemctl stop matter2mqtt.service      2>/dev/null || true
fi

# matter2mqtt itself moved from /srv to /opt (zigbee2mqtt-style layout); clear our own stale
# program dir. Data lives in /var/lib/matter2mqtt and is untouched.
rm -rf /srv/matter2mqtt 2>/dev/null || true

# Node.js must be system-provided and >= 22.13 (matter-server engine requirement).
if ! command -v node >/dev/null 2>&1; then
    echo "matter2mqtt: WARNING Node.js not found; service will not start (need >=22.13)."
fi

# mosquitto: intentionally NOT touched here — it is a shared broker; if already installed
# we neither reinstall nor stop it.

exit 0
