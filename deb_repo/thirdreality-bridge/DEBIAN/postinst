#!/bin/bash
set -e
function info { echo -e "\e[32m[info] $*\e[39m"; }
function warn  { echo -e "\e[33m[warn] $*\e[39m"; }
function error { echo -e "\e[31m[error] $*\e[39m"; exit 1; }

# Check install or upgrade
if [ "$1" = "configure" ]; then

	if [ -f "/usr/local/bin/linuxbox-hubv3-bridge" ]; then
		chmod +x /usr/local/bin/linuxbox-hubv3-bridge > /dev/null 2>&1
	fi

	# Ensure data dir exists
	mkdir -p /var/lib/hubv3-bridge > /dev/null 2>&1

	# Handle command.sh: always overwrite from default template
	if [ -f "/var/lib/hubv3-bridge/command.sh.default" ]; then
		info "Overwriting command.sh from default template"
		cp /var/lib/hubv3-bridge/command.sh.default /var/lib/hubv3-bridge/command.sh
		chmod +x /var/lib/hubv3-bridge/command.sh > /dev/null 2>&1
		/usr/bin/sync
	fi

	# Handle configuration.yaml: only create if missing
	if [ ! -f "/var/lib/hubv3-bridge/configuration.yaml" ] && \
	   [ -f "/var/lib/hubv3-bridge/configuration.yaml.default" ]; then
		info "Creating configuration.yaml from default template"
		cp /var/lib/hubv3-bridge/configuration.yaml.default /var/lib/hubv3-bridge/configuration.yaml
	elif [ -f "/var/lib/hubv3-bridge/configuration.yaml" ]; then
		info "Keeping existing configuration.yaml (user may have modified it)"
	fi

    # Reload systemd units before enabling/starting services
    /usr/bin/systemctl daemon-reload > /dev/null 2>&1

    if [ -f "/lib/systemd/system/linuxbox-hubv3-bridge.service" ]; then
        /usr/bin/systemctl enable --now linuxbox-hubv3-bridge.service
    fi

	info "Install success."
elif [ "$1" = "fix-dependency" ]; then
    echo "fix-dependency"
fi

exit 0

