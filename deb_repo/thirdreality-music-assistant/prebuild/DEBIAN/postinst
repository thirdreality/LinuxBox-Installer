#!/bin/bash
# postinst script for thirdreality-hacore
# 改进版本 - 支持优雅升级，保留用户配置

set -e

# 彩色日志函数
function info { echo -e "\e[32m[info] $*\e[39m"; }
function warn  { echo -e "\e[33m[warn] $*\e[39m"; }
function error { echo -e "\e[31m[error] $*\e[39m"; exit 1; }

# 获取升级信息
get_upgrade_info() {
    UPGRADE_LOG=""
    BACKUP_DIR=""
    
    if [ -f "/tmp/hacore-upgrade-log-path.txt" ]; then
        UPGRADE_LOG=$(cat /tmp/hacore-upgrade-log-path.txt)
    fi
    
    if [ -f "/tmp/hacore-upgrade-backup-path.txt" ]; then
        BACKUP_DIR=$(cat /tmp/hacore-upgrade-backup-path.txt)
    fi
}

# 记录升级日志
log_upgrade() {
    if [ -n "$UPGRADE_LOG" ]; then
        echo "$(date '+%Y-%m-%d %H:%M:%S') - $*" >> "$UPGRADE_LOG"
    fi
}

# 首次安装的配置清理
handle_fresh_install() {
    info "Performing fresh installation configuration..."
    
    # 清理旧的配置文件（仅在全新安装时）
    rm -rf /usr/share/hassio/homeassistant/zha.conf* 2>/dev/null || true
    rm -rf /var/lib/homeassistant/zha.conf 2>/dev/null || true
    rm -rf /var/lib/homeassistant/zha.conf.bak 2>/dev/null || true
    
    log_upgrade "Fresh install: Cleaned old configuration files"
}

# 升级时的配置处理
handle_upgrade_config() {
    local old_version="$1"
    info "Configuring upgrade from version $old_version..."
    
    # 备份现有配置（如果尚未备份）
    if [ -f "/var/lib/homeassistant/zha.conf" ] && [ -n "$BACKUP_DIR" ]; then
        if [ ! -f "$BACKUP_DIR/zha.conf" ]; then
            cp /var/lib/homeassistant/zha.conf "$BACKUP_DIR/" || true
            log_upgrade "Backed up zha.conf during upgrade"
        fi
    fi
    
    # 检查是否需要清理旧配置（仅针对特定版本升级）
    # 例如：从某个有问题的版本升级时才清理
    # if dpkg --compare-versions "$old_version" eq "2025.9.0"; then
    #     warn "Cleaning problematic config from version $old_version"
    #     rm -rf /var/lib/homeassistant/zha.conf.bak || true
    # fi
    
    log_upgrade "Configuration preserved during upgrade"
}

# 创建必要的目录结构
create_directories() {
    info "Creating necessary directories..."
    
    mkdir -p /var/lib/homeassistant
    mkdir -p /var/lib/homeassistant/music_assistant
    
    # 创建运行时目录（使用更安全的权限）
    mkdir -p /data /updates
    chmod 755 /data /updates
    chmod 755 /var/lib/homeassistant/music_assistant
    
    log_upgrade "Directories created successfully"
}

# 设置脚本权限
setup_script_permissions() {
    info "Setting up script permissions..."
    
    local scripts=(
        "generate_mass_config.py"
    )
    
    for script in "${scripts[@]}"; do
        if [ -e "/srv/music-assistant/bin/$script" ]; then
            chmod +x "/srv/music-assistant/bin/$script" > /dev/null 2>&1 || true
        fi
    done

    if [ -f "/usr/local/bin/ffmpeg" ]; then
        chmod +x /usr/local/bin/ffmpeg
        /usr/local/bin/ffmpeg -version
    fi

    if [ -f "/usr/local/bin/ffprobe" ]; then
        chmod +x /usr/local/bin/ffprobe
        /usr/local/bin/ffprobe -version
    fi
        
    log_upgrade "Script permissions configured"
}

# 更新 Music Assistant 默认配置
update_music_assistant_config() {
    local is_fresh_install="$1"
    
    # 只在首次安装时执行初始化脚本
    # 升级时不执行，避免修改用户已有配置
    if [ "$is_fresh_install" = "true" ]; then
        info "Update music assistant default config (fresh install)..."
        

        # 如果缺少 settings.json，则生成默认配置
        if [ ! -f "/var/lib/homeassistant/music_assistant/settings.json" ]; then
            info "settings.json missing, generating default config..."
            if [ -x "/srv/music-assistant/bin/python3" ]; then
                /srv/music-assistant/bin/python3 /srv/music-assistant/bin/generate_mass_config.py \
                    /srv/music-assistant/template.json \
                    /var/lib/homeassistant/music_assistant || warn "Failed to generate settings.json"
            else
                warn "Generator not found at /srv/music-assistant/bin/python3"
            fi
        fi

        # 复制 options.json 供默认使用
        if [ -f "/srv/music-assistant/options.json" ]; then
            cp -a /srv/music-assistant/options.json /var/lib/homeassistant/music_assistant/ || warn "Failed to copy options.json"
        else
            warn "options.json not found at /srv/music-assistant"
        fi
    else
        info "Skipping music assistant config update during upgrade to preserve user data"
        log_upgrade "Skipped music assistant initialization during upgrade"
    fi
}

# 配置并启动服务
configure_services() {
    info "Configuring systemd services..."
    
    /usr/bin/systemctl daemon-reload
    /usr/bin/systemctl enable music-assistant.service
    
    log_upgrade "Services enabled"
}

# 检查网络连接并启动服务
start_services_if_network_ready() {
    info "Checking network connectivity..."
    /usr/bin/systemctl start music-assistant.service
    log_upgrade "Services started successfully"
}

# 清理升级临时文件
cleanup_upgrade_files() {
    rm -f /tmp/music-assistant-upgrade-log-path.txt || true
    rm -f /tmp/music-assistant-upgrade-backup-path.txt || true
}

show_completion_message() {
    local old_version="$1"
    
    echo ""
    info "========================================"
    if [ -z "$old_version" ]; then
        info "Music Assistant installation completed successfully!"
    else
        info "Music Assistant upgrade completed successfully!"
        info "Upgraded from version: $old_version"
    fi
    
    if [ -n "$BACKUP_DIR" ] && [ -d "$BACKUP_DIR" ]; then
        info "Backup location: $BACKUP_DIR"
    fi
    
    if [ -n "$UPGRADE_LOG" ] && [ -f "$UPGRADE_LOG" ]; then
        info "Upgrade log: $UPGRADE_LOG"
    fi
    
    info "========================================"
    echo ""
}

# 主配置逻辑
main() {
    if [ "$1" = "configure" ]; then
        get_upgrade_info
        
        OLD_VERSION="$2"
        
        # 判断是首次安装还是升级
        if [ -z "$OLD_VERSION" ]; then
            # 首次安装
            log_upgrade "Starting fresh installation"
            handle_fresh_install
        else
            # 升级
            log_upgrade "Starting upgrade from version $OLD_VERSION"
            handle_upgrade_config "$OLD_VERSION"
        fi
        
        # 通用配置步骤
        create_directories
        setup_script_permissions
        
        # 判断是否是首次安装
        if [ -z "$OLD_VERSION" ]; then
            update_music_assistant_config "true"  # 首次安装
        else
            update_music_assistant_config "false"  # 升级，跳过初始化
        fi
        
        configure_services
        start_services_if_network_ready
        
        # 完成升级
        log_upgrade "Upgrade completed successfully"
        show_completion_message "$OLD_VERSION"
        cleanup_upgrade_files
        
    elif [ "$1" = "fix-dependency" ]; then
        info "fix-dependency"
        log_upgrade "Running fix-dependency"
    fi
}

main "$@"

exit 0

