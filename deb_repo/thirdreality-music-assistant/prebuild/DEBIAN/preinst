#!/bin/bash
# preinst script for thirdreality-hacore
# 改进版本 - 支持优雅升级

set -e

# 日志函数
log_info() {
    echo "[INFO] $*" >&2
}

log_warn() {
    echo "[WARN] $*" >&2
}

log_error() {
    echo "[ERROR] $*" >&2
}

# 检查 Python 3.14 是否存在（MA 2.9.x 起要求 Python >= 3.14，与 thirdreality-python3 对齐）
check_python() {
    [ -f "/usr/bin/python3.14" ] || \
    [ -f "/usr/local/bin/python3.14" ] || \
    [ -f "/usr/local/python3/bin/python3.14" ] || {
        log_error "Python 3.14 not found in any of:"
        log_error "  /usr/bin/python3.14"
        log_error "  /usr/local/bin/python3.14"
        log_error "  /usr/local/python3/bin/python3.14"
        exit 1
    }
}

# 停止服务
stop_services() {
    log_info "Stopping services if running..."
    
    if [[ "$(/usr/bin/systemctl is-active music-assistant.service)" == "active" ]]; then
        log_info "Stopping music-assistant.service"
        /usr/bin/systemctl stop music-assistant.service > /dev/null 2>&1 || true
    fi
}

# 首次安装处理
handle_install() {
    log_info "Performing fresh installation..."
    
    # 清理旧的安装（如果存在）
    if [[ -e "/srv/music-assistant" ]]; then
        log_warn "Removing existing /srv/music-assistant directory"
        rm -rf /srv/music-assistant
    fi
}

# 升级处理
handle_upgrade() {
    local old_version="$1"
    log_info "Upgrading from version $old_version..."
    
    # 创建升级日志目录
    UPGRADE_LOG_DIR="/var/lib/homeassistant/upgrade-logs"
    mkdir -p "$UPGRADE_LOG_DIR"
    
    UPGRADE_LOG="$UPGRADE_LOG_DIR/music-assistant-upgrade-$(date +%Y%m%d-%H%M%S).log"
    
    {
        echo "========================================"
        echo "Upgrade started at: $(date)"
        echo "From version: $old_version"
        echo "========================================"
    } >> "$UPGRADE_LOG"
    
    # 创建升级备份
    BACKUP_DIR="/var/lib/homeassistant/music-assistant-backup-$(date +%Y%m%d-%H%M%S)"
    mkdir -p "$BACKUP_DIR"
    
    log_info "Creating backup in $BACKUP_DIR..."
    
    # 备份关键配置文件
    if [ -f "/var/lib/homeassistant/music_assistant/settings.json" ]; then
        cp -a /var/lib/homeassistant/music_assistant/settings.json "$BACKUP_DIR/" || true
        echo "Backed up: settings.json" >> "$UPGRADE_LOG"
    fi
    
    if [ -f "/var/lib/homeassistant/music_assistant/options.json" ]; then
        cp -a /var/lib/homeassistant/music_assistant/options.json "$BACKUP_DIR/" || true
        echo "Backed up: options.json" >> "$UPGRADE_LOG"
    fi
    
    if [ -f "/var/lib/homeassistant/music_assistant/library.db" ]; then
        cp -a /var/lib/homeassistant/music_assistant/library.db "$BACKUP_DIR/" || true
        echo "Backed up: library.db" >> "$UPGRADE_LOG"
    fi

    if [ -d "/var/lib/homeassistant/music_assistant/playlists" ]; then
        cp -a /var/lib/homeassistant/music_assistant/playlists "$BACKUP_DIR/" -R || true
        echo "Backed up: playlists" >> "$UPGRADE_LOG"
    fi    

    # 记录当前已安装的包版本
    dpkg -l | grep thirdreality > "$BACKUP_DIR/installed-packages.txt" || true
    
    # 清理虚拟环境中的 Python 缓存（但保留虚拟环境本身）
    if [[ -e "/srv/music-assistant" ]]; then
        log_info "Cleaning Python cache files..."
        find /srv/music-assistant -name "*.pyc" -delete 2>/dev/null || true
        find /srv/music-assistant -name "__pycache__" -type d -exec rm -rf {} + 2>/dev/null || true
        echo "Cleaned Python cache files" >> "$UPGRADE_LOG"
    fi

    # 保存备份路径供 postinst 使用
    echo "$BACKUP_DIR" > /tmp/music-assistant-upgrade-backup-path.txt
    echo "$UPGRADE_LOG" > /tmp/music-assistant-upgrade-log-path.txt
    
    log_info "Backup completed: $BACKUP_DIR"
       
    # 磁盘空间检查
    AVAILABLE_SPACE=$(df /srv | awk 'NR==2 {print $4}')
    REQUIRED_SPACE=1048576  # 1GB in KB
    
    if [ "$AVAILABLE_SPACE" -lt "$REQUIRED_SPACE" ]; then
        log_error "Insufficient disk space. Required: 1GB, Available: $((AVAILABLE_SPACE/1024))MB"
        echo "ERROR: Insufficient disk space" >> "$UPGRADE_LOG"
        exit 1
    fi
    
    echo "Disk space check passed: ${AVAILABLE_SPACE}KB available" >> "$UPGRADE_LOG"
}

# 主逻辑
main() {
    check_python
    stop_services
    
    case "$1" in
        install)
            handle_install
            ;;
        upgrade)
            if [ -n "$2" ]; then
                handle_upgrade "$2"
            else
                log_warn "No old version specified, treating as fresh install"
                handle_install
            fi
            ;;
        *)
            log_info "preinst called with unknown argument: $1"
            ;;
    esac
}

main "$@"

exit 0

