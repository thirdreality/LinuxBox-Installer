#!/bin/bash
set -e
function info { echo -e "\e[32m[info] $*\e[39m"; }
function warn  { echo -e "\e[33m[warn] $*\e[39m"; }
function error { echo -e "\e[31m[error] $*\e[39m"; exit 1; }

# Configurable version number
armbian_version="20"

# Board type configuration
board_type="trhubv3b"

# Check install or upgrade
if [ "$1" = "configure" ]; then

	if [ -f "/lib/armbian/factory-reset.sh" ]; then
		chmod +x /lib/armbian/factory-reset.sh > /dev/null 2>&1
	fi

	if [ -f "/lib/armbian/armbian-firstrun" ]; then
		chmod +x /lib/armbian/armbian-firstrun > /dev/null 2>&1
	fi

	if [ -f "/lib/thirdreality/hubv3-usb-sync-latest.sh" ]; then
		chmod +x /lib/thirdreality/hubv3-usb-sync-latest.sh > /dev/null 2>&1
	fi

	if [ -f "/lib/thirdreality/hubv3-generate-ota-indexes.sh" ]; then
		chmod +x /lib/thirdreality/hubv3-generate-ota-indexes.sh > /dev/null 2>&1
	fi

	if [ -f "/usr/local/bin/supervisor" ]; then
		chmod +x /usr/local/bin/supervisor > /dev/null 2>&1
	fi

    # Reload systemd units before enabling/starting services
    /usr/bin/systemctl daemon-reload > /dev/null 2>&1

    if [ -f "/etc/systemd/system/supervisor.service" ]; then
        /usr/bin/systemctl enable --now supervisor.service
    fi

    if [ -f "/etc/systemd/system/btgatt-config.service" ]; then
		/usr/bin/systemctl disable btgatt-config.service
	fi

	# Update version information in /etc/t3r-release
	update_t3r_version() {
		if [ -f "/etc/t3r-release" ]; then
			info "Updating /etc/t3r-release version information..."
			
			# Get current VERSION and extract components
			local current_version=$(grep '^VERSION=' /etc/t3r-release | cut -d'"' -f2 | sed 's/^v//')
			if [ -n "$current_version" ]; then
				# Extract major.minor.patch parts (e.g., 1.03.01 from 1.03.01.04)
				local major_minor_patch=$(echo "$current_version" | cut -d'.' -f1-3)
				local new_version="v${major_minor_patch}.${armbian_version}"
				
				# Update VERSION
				sed -i "s/^VERSION=.*/VERSION=\"${new_version}\"/" /etc/t3r-release
				
				# Update VERSION_ID (format: 1XXYYZZ where XX=major, YY=minor, ZZ=patch)
				local major=$(echo "$major_minor_patch" | cut -d'.' -f1)
				local minor=$(echo "$major_minor_patch" | cut -d'.' -f2)
				local patch=$(echo "$major_minor_patch" | cut -d'.' -f3)
				local new_version_id="1${minor}${patch}${armbian_version}"
				
				sed -i "s/^VERSION_ID=.*/VERSION_ID=\"${new_version_id}\"/" /etc/t3r-release
				
				/usr/bin/sync
				
				info "Updated VERSION to ${new_version}"
				info "Updated VERSION_ID to ${new_version_id}"
			else
				warn "Could not parse current VERSION from /etc/t3r-release"
			fi
		else
			warn "/etc/t3r-release file not found, skipping version update"
		fi
	}
	
	# Update model information in /etc/t3r-release and /etc/armbian-release
	update_t3r_modle() {
		info "Updating model information..."
		
		# Update /etc/t3r-release
		if [ -f "/etc/t3r-release" ]; then
			sed -i 's/^PRETTY_NAME=.*/PRETTY_NAME="Third Reality Care Hub"/' /etc/t3r-release
			sed -i 's/^NAME=.*/NAME="LinuxBox\/HubV3"/' /etc/t3r-release
			/usr/bin/sync
			info "Updated PRETTY_NAME and NAME in /etc/t3r-release"
		else
			warn "/etc/t3r-release file not found, skipping model update"
		fi
		
		# Update /etc/armbian-release
		if [ -f "/etc/armbian-release" ]; then
			sed -i 's/^BOARD=.*/BOARD=trhubv3b/' /etc/armbian-release
			sed -i 's/^BOARD_NAME=.*/BOARD_NAME="TRHub-V3B"/' /etc/armbian-release
			/usr/bin/sync
			info "Updated BOARD and BOARD_NAME in /etc/armbian-release"
		else
			warn "/etc/armbian-release file not found, skipping model update"
		fi
	}
	
	# Fix zigbee2mqtt configuration
	fixed_zigbee2mqtt() {
		local config_file="/opt/zigbee2mqtt/data/configuration.yaml"
		
		if [ ! -f "$config_file" ]; then
			info "zigbee2mqtt configuration file not found, skipping"
			return
		fi
		
		info "Fixing zigbee2mqtt configuration..."
		
		# Stop zigbee2mqtt.service if it exists and is running
		if command -v systemctl >/dev/null 2>&1; then
			if systemctl list-unit-files | grep -q "zigbee2mqtt.service"; then
				if systemctl is-active --quiet zigbee2mqtt.service 2>/dev/null; then
					info "Stopping zigbee2mqtt.service"
					systemctl stop zigbee2mqtt.service || true
				fi
			fi
		fi
		
		# Backup configuration.yaml
		local backup_timestamp=$(date +%Y%m%d_%H%M%S)
		local backup_file="/opt/zigbee2mqtt/data/configuration_${backup_timestamp}.yaml"
		cp "$config_file" "$backup_file"
		/usr/bin/sync
		info "Backed up configuration to ${backup_file}"
		
		# Use Python to modify YAML file
		/usr/bin/python3 << EOF
import yaml
import sys

try:
    with open('$config_file', 'r') as f:
        config = yaml.safe_load(f) or {}
    
    # Update mqtt section
    config['mqtt'] = {
        'base_topic': 'zigbee2mqtt',
        'server': 'mqtt://localhost:1883',
        'user': 'thirdreality',
        'password': 'thirdreality'
    }
    
    with open('$config_file', 'w') as f:
        yaml.dump(config, f, default_flow_style=False, sort_keys=False, allow_unicode=True)
    
    sys.exit(0)
except Exception as e:
    print(f"Error: {e}", file=sys.stderr)
    sys.exit(1)
EOF
		if [ $? -eq 0 ]; then
			/usr/bin/sync
			info "Updated zigbee2mqtt configuration successfully"
		else
			error "Failed to update zigbee2mqtt configuration"
		fi
	}
	
	# Call version update function
	update_t3r_version
	
	# Call model update function if board_type is trhubv3b
	if [ "$board_type" = "trhubv3b" ]; then
		update_t3r_modle
	fi
	
	# Call zigbee2mqtt fix function if board_type is trhubv3b
	if [ "$board_type" = "trhubv3b" ]; then
		fixed_zigbee2mqtt
	fi

	info "Install success."
elif [ "$1" = "fix-dependency" ]; then
    echo "fix-dependency"
fi

exit 0

