# Build artifacts
deb_repo/*/output/
deb_repo/*/*.deb
deb_repo/*/build.log

# Downloaded / extracted Python sources
deb_repo/thirdreality-python3*/Python-*.tgz
deb_repo/thirdreality-python3*/Python-*/

# Cloned upstream source for otbr-agent build
deb_repo/thirdreality-otbr-agent/ot-br-posix/

# Temporary swapfile created by build_common.sh (shared low-memory OOM guard)
deb_repo/*/.build-swap

# Raw (un-sanitized) matter-server logs — may contain Wi-Fi credentials / IPK.
# Only the *_sanitized.log variants are safe to commit.
*.raw.log
core_matter_server_*.log
# matter-server fork release tarball (built by build-tarball.sh / GitHub Release artifact)
deb_repo/thirdreality-matter2mqtt/prebuild/matter-server-*.tgz
deb_repo/thirdreality-matter2mqtt/prebuild/matter-server-*.tgz.sha256
